{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.prototypr/feedbagel",
  "description": "Search RSS feeds, follow them, and route new entries to webhooks via the Feedbagel API.",
  "repository": {
    "url": "https://github.com/Prototypr/feedbagel-mcp",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "feedbagel-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FEEDBAGEL_API_KEY",
          "description": "Agent-scoped API key from https://feedbagel.com/dashboard/keys",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
